# Copy to .env.production on the EC2 host and fill in. Never commit the real file.

# RDS. sslmode=require is not optional on a public-ish endpoint.
DATABASE_URL="postgresql://algopath:CHANGE_ME@your-instance.abcdef.ap-south-1.rds.amazonaws.com:5432/algopath?sslmode=require"

# Clerk (production instance keys, not the dev ones)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Upstash Redis for rate limiting. Omitted = limiters disable themselves.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Used for metadataBase, so OG and canonical URLs resolve.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
